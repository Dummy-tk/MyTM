@inherits LayoutComponentBase
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="1rem"
                     class="rz-px-4">

            <RadzenSidebarToggle Click="@ToggleSidebar" />

            <RadzenText Text="QUẢN LÝ KHÁCH RA VÀO"
                        TextStyle="TextStyle.H5"
                        class="rz-m-0" />

        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="sidebarExpanded">
        <NavMenu />
    </RadzenSidebar>

    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>

    <RadzenFooter>
        <div class="rz-px-4 rz-py-2">
            Hệ thống quản lý khách ra vào cơ quan
        </div>
    </RadzenFooter>
</RadzenLayout>

@code {
    private bool sidebarExpanded = true;

    private void ToggleSidebar()
    {
        sidebarExpanded = !sidebarExpanded;
        Console.WriteLine($"Sidebar expanded: {sidebarExpanded}");
    }
}